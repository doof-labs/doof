# doof server configuration. Copy to .env for local development.
# These defaults run a disposable local instance with no external services.
PORT=3005
PUBLIC_URL=http://localhost:3005
# Comma-separated hostnames accepted in the Host header (DNS rebinding protection).
ALLOWED_HOSTS=localhost,127.0.0.1
# Set to the number of trusted reverse-proxy hops in production (often 1).
# Leave false when connecting directly; an incorrect value weakens IP rate limits.
TRUST_PROXY=false

# Local development uses memory and loses everything on restart.
# Production must use postgres and set DATABASE_URL.
STORE=memory
DATABASE_URL=

# Production secrets and services. Production startup fails if any is missing.
# Ed25519 private key, base64 PKCS8. Generate with the command in README.md.
DOOF_SIGNING_KEY=
# Resend API key. Without it in development, emails are printed to stdout.
RESEND_API_KEY=

# Deployment identity. Set these to your own public URL and verified sender.
NOTICE_FROM="doof <notices@example.com>"

# Optional controls.
# Local-only design states at /_preview. Never enable this in production.
ENABLE_PREVIEWS=false
MAX_CONFESSIONS_PER_DAY=60
# Which statuses send an immediate email. Others appear on the record page only.
NOTIFY_STATUSES=hesitated,completed,uncertain
