{
  "name": "doof",
  "version": "0.1.0",
  "private": true,
  "description": "Independent disclosure infrastructure for AI agents.",
  "license": "Apache-2.0",
  "homepage": "https://doof.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/doof-labs/doof.git"
  },
  "bugs": "https://github.com/doof-labs/doof/issues",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').copyFileSync('src/db/schema.sql','dist/db/schema.sql')\"",
    "start": "node dist/index.js",
    "test": "vitest run",
    "migrate": "tsx --env-file-if-exists=.env src/db/migrate.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "^2.0.0",
    "@modelcontextprotocol/node": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "express": "^5.2.1",
    "pg": "^8.23.0",
    "posthog-node": "^5.20.0",
    "resend": "^6.25.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.123.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.23.1",
    "openai": "^7.9.0",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
